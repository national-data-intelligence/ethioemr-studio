map $request_uri $csp_header {
  default "default-src 'self' 'unsafe-inline' 'unsafe-eval' localhost localhost:*; connect-src 'self' localhost localhost:* ${AI_CONNECT_SRC}; base-uri 'self'; font-src 'self'; img-src 'self' data:; frame-src 'self' blob:; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  "~^/openmrs/(?:admin|dictionary|module|patientDashboard.form)/" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self'; frame-src 'self' blob:; frame-ancestors 'self';";
  "~^/openmrs/owa" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self' data:; img-src 'self' data:; frame-src 'self' blob:; frame-ancestors 'self';";
}

map $http_x_forwarded_proto $forwarded_proto {
  "~.*" $http_x_forwarded_proto;
  default    $scheme;
}

map $http_x_real_ip $forwarded_ip {
  "~.*"  $http_x_real_ip;
  default $remote_addr;
}

map $forwarded_proto $var_proxy_cookie_flags {
  https   "JSESSIONID secure samesite=strict";
  default "off";
}

upstream frontend {
  # always assume the frontend will be available
  server frontend max_fails=0;
}

upstream backend {
  server backend:8080 max_fails=0;
}

server {
  listen       80;

  add_header X-XSS-Protection "1; mode=block";
  add_header Content-Security-Policy $csp_header;
  add_header X-Content-Type-Options nosniff;

  proxy_set_header      HOST $host;
  proxy_set_header      X-Forwarded-Proto $forwarded_proto;
  proxy_set_header      X-Real-IP $forwarded_ip;
  proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
  # if serving this via HTTPS, the following is recommended
  # proxy_cookie_flags      $var_proxy_cookie_flags;
  proxy_http_version    1.1;

  gzip on;
  gzip_vary on;
  # 1 KiB
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_http_version 1.0;
  gzip_types  font/eot
              font/otf
              font/ttf
              image/svg+xml
              text/css
              text/html
              text/javascript
              text/plain
              text/xml
              application/atom+xml
              application/geo+json
              application/importmap+json
              application/javascript
              application/x-javascript
              application/json
              application/ld+json
              application/fhir+json
              application/fhir+xml
              application/manifest+json
              application/rdf+xml
              application/rss+xml
              application/xhtml+xml
              application/xml;

  # all redirects are relative to the gateway
  absolute_redirect off;

  location = /openmrs/spa {
    return 301 /openmrs/spa/;
  }

  # PLATFORM CHANGE: the published frontend image (frontend/Dockerfile, built by
  # CI for Kubernetes) serves under /openmrs/spa/, so pass the full path through. The team's template strips it,
  # which only suits the local frontend build (frontend/Dockerfile.local).
  location /openmrs/spa/ {
    proxy_pass http://frontend;
    # PLATFORM: the published frontend bakes its config-file list into index.html at build time (SPA_CONFIG_URLS
    # is ignored), so add the AI assistant's config file to that list as the page passes through. Later files win,
    # so it goes first: it only sets the assistant's own keys. Needs an uncompressed upstream response.
    proxy_set_header Accept-Encoding "";
    sub_filter_once on;
    sub_filter 'configUrls: [' 'configUrls: ["/openmrs/spa/ai-assistant.config.json", ';
  }

  # PLATFORM OVERLAY: modules that are not (yet) in the published frontend image (Form Studio, AI assistant).
  # tools/build-spa-overlay.py writes work/spa-overlay/: the frontend's app list and route registry merged with
  # those modules, plus each module's built files under modules/<name>/. Never cached, so a rebuild shows on refresh.
  location = /openmrs/spa/importmap.json {
    alias /srv/spa-overlay/importmap.json;
    default_type application/json;
    add_header Cache-Control "no-store";
  }
  location = /openmrs/spa/routes.registry.json {
    alias /srv/spa-overlay/routes.registry.json;
    default_type application/json;
    add_header Cache-Control "no-store";
  }
  location /openmrs/spa/overlay/ {
    alias /srv/spa-overlay/modules/;
    add_header Cache-Control "no-store";
  }

  # AI assistant config, filled from .env at container start (the key is never stored in the repo).
  # Like any frontend config, the browser can read it, key included.
  location = /openmrs/spa/ai-assistant.config.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"@palladium-ethiopia/esm-ai-assistant-app":{"aiServiceUrl":"${AI_SERVICE_URL}","aiServiceApiKey":"${AI_SERVICE_API_KEY}","asrServiceUrl":"${ASR_SERVICE_URL}"}}';
  }

  # The EthioEMR config asks for logos, icons and translations under /openmrs/spa/config/...; the published
  # frontend keeps them under /config/... (the backend's spa-config volume), so map that one prefix.
  location /openmrs/spa/config/ {
    proxy_pass http://frontend/config/;
  }

  location /openmrs {
    proxy_pass http://backend;
  }

  location = / {
    return 301 /openmrs/spa/;
  }
}
