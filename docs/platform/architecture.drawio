                <mxCell id="title" value="&lt;b style=&quot;font-size:20px;color:#101113&quot;&gt;ETHIOEMR PLATFORM: HOW IT FITS TOGETHER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280&quot;&gt;Team distro main 9147129, unchanged, plus our two modules and the local speech service.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#374151;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1200" height="56" as="geometry"/></mxCell>
