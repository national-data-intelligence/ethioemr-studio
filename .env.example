# Copy to .env (git-ignored) and fill in. docker compose reads .env from the repo root (platform.ps1 runs from there).

# Team images: the commit of distro/ (byte-for-byte GitHub main of ethiopiaemr-distro-referenceapplication)
PLATFORM_IMAGE_NS=meronmen
PLATFORM_IMAGE_TAG=sha-9147129

# Ports (chosen not to clash with other local EMR stacks on 18080, 18090, 18100, 3308 and 3309)
PLATFORM_HTTP_PORT=18200
PLATFORM_DB_PORT=3320

# AI assistant (served to the browser as /openmrs/spa/ai-assistant.config.json by the gateway)
AI_SERVICE_URL=https://emr-ai.20.84.70.78.nip.io
AI_SERVICE_API_KEY=
ASR_SERVICE_URL=http://localhost:8767
# Addresses the browser may call besides the EMR itself (Content-Security-Policy connect-src)
AI_CONNECT_SRC=https://emr-ai.20.84.70.78.nip.io http://localhost:8767 http://127.0.0.1:8767

# Optional: password for the SHR pull account (team compose); leave empty locally
SHR_PULL_PASSWORD=
