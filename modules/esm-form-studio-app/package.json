{
  "name": "@palladium-ethiopia/esm-form-studio-app",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "description": "Form Studio: build, check and test AMPATH forms for EthioEMR test instances",
  "browser": "dist/palladium-ethiopia-esm-form-studio-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "build": "rspack --mode production",
    "analyze": "rspack --mode=production --env analyze=true",
    "lint": "eslint src --max-warnings 0",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\" --list-different",
    "typescript": "tsc",
    "test": "cross-env TZ=UTC vitest run --passWithNoTests",
    "test:watch": "cross-env TZ=UTC vitest watch",
    "verify": "turbo lint typescript coverage",
    "coverage": "cross-env TZ=UTC vitest run --coverage --passWithNoTests",
    "extract-translations": "i18next 'src/**/*.component.tsx' --config ./tools/i18next-parser.config.js",
    "test-e2e": "playwright test"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends",
    "ethioemr",
    "forms"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@carbon/react": "^1.83.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openmrs/esm-form-engine-lib": "4.2.1",
    "ace-builds": "^1.32.8",
    "ajv": "^8.17.1",
    "classnames": "^2.5.1",
    "fflate": "^0.8",
    "file-loader": "^6.2.0",
    "lodash-es": "^4.17.21",
    "react-ace": "^11.0.1",
    "react-error-boundary": "^4.0.13",
    "react-markdown": "^9.0.1",
    "react-mde": "^11.5.0",
    "read-excel-file": "^5",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x",
    "dayjs": "1.x",
    "react": "18.x",
    "react-dom": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x"
  },
  "devDependencies": {
    "@openmrs/eslint-config": "^2.1.0",
    "@openmrs/esm-framework": "10.0.1-pre.5263",
    "@openmrs/esm-styleguide": "10.0.1-pre.5263",
    "@playwright/test": "^1.52.0",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.3.68",
    "@testing-library/dom": "^10.1.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^9",
    "@vitest/coverage-v8": "^4.1.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.0",
    "happy-dom": "^20.0.0",
    "husky": "^8.0.3",
    "i18next": "^25.0.0",
    "i18next-parser": "^9.3.0",
    "lint-staged": "^15.2.2",
    "openmrs": "10.0.1-pre.5263",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.14.1",
    "rxjs": "^6.6.7",
    "turbo": "^2.5.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": "eslint --cache --fix --max-warnings 0",
    "*.{css,scss,ts,tsx}": "prettier --write --list-different"
  },
  "packageManager": "yarn@4.10.3",
  "private": true,
  "//": "App shell pinned to 10.0.1-pre.5263 to match EthioEMR (distro/frontend/Dockerfile APP_SHELL_VERSION, spa-assemble-config.json _comment). Keep in lockstep with the distro."
}
